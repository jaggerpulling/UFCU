VITE_API_URL=/api
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
MOCK_PASSPORT=true
MOCK_SCHOOL=true
MOCK_NOVA=false

# Nova selects the sandbox only when all four credentials are present. Otherwise
# it safely falls back to the visibly labeled demo mock provider.
NOVA_PROVIDER=auto
NOVA_API_BASE_URL=https://api.sandbox.novacredit.com
NOVA_CLIENT_ID=
NOVA_SECRET_KEY=
NOVA_PUBLIC_ID=
NOVA_PRODUCT_ID=
# Optional UUID for a custom sandbox report configured by Nova Credit.
NOVA_SANDBOX_REPORT_ID=
