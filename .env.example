VITE_API_URL=/api
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
MOCK_PASSPORT=true
IDENTITY_PROVIDER=mock_socure
# Reserved for a future authenticated, server-side-only provider implementation.
# The offline hackathon demo does not need either value.
SOCURE_API_BASE_URL=
SOCURE_API_KEY=

# DocuSign — Demo uses an offline provider. Future embedded-signing credentials
# are intentionally server-only; never expose them with a VITE_ prefix.
ESIGNATURE_PROVIDER=mock_docusign
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY=
MOCK_NOVA=false
STUDENT_VERIFICATION_PROVIDER=mock_nsc

# Nova selects the sandbox only when all four credentials are present. Otherwise
# it safely falls back to the visibly labeled demo mock provider.
NOVA_PROVIDER=auto
NOVA_API_BASE_URL=https://api.sandbox.novacredit.com
NOVA_CLIENT_ID=
NOVA_SECRET_KEY=
NOVA_PUBLIC_ID=
NOVA_PRODUCT_ID=
# Optional UUID for a custom sandbox report configured by Nova Credit.
NOVA_SANDBOX_REPORT_ID=
